# AttendOS development-Supabase preflight — variable NAMES only. Copy to a file OUTSIDE the repository (for example
# ~/.attendos-dev.env, chmod 600), fill it in there, and load it in your own terminal with:  set -a; . ~/.attendos-dev.env; set +a
# Never paste these values into chat, issues, commits or reports.

# Reference ID of the DEVELOPMENT project: Dashboard → Project Settings → General → Reference ID (20 lowercase letters)
ATTENDOS_DEV_PROJECT_REF=
# Comma-separated reference IDs these tools must NEVER touch (pilot / production, once they exist)
ATTENDOS_FORBIDDEN_PROJECT_REFS=
# Session-pooler connection string of the DEVELOPMENT project (Connect → Session pooler), user postgres.<ref>, with the DB password
ATTENDOS_DEV_DB_URL=
# API URL of the DEVELOPMENT project: exactly https://<ref>.supabase.co
ATTENDOS_DEV_SUPABASE_URL=
# The DEVELOPMENT project's anon / publishable key (never the service-role / secret key)
ATTENDOS_DEV_ANON_KEY=
# Local JSON file (outside the repo, chmod 600) with the 8 synthetic test logins — see README
ATTENDOS_DEV_LOGINS_FILE=
# Folder for the tools' redacted reports (outside the repo)
ATTENDOS_DEV_REPORT_DIR=~/attendos-dev-reports
