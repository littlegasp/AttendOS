# Supabase project (Mumbai region) → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon public" / "publishable" key. Safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER put the secret key (sb_secret_…) or service_role key here or in Cloudflare: AttendOS does not use it.
# Leave both empty to run the clearly labelled design preview (no data, no sign-in).
