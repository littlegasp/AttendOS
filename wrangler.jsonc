{
  // Static files served by Cloudflare. `npm run build` writes the site to out/ and
  // `npx wrangler deploy` uploads it. No Worker code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attendos",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  }
}
